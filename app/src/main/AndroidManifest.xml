<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />
    <!-- V2.0 (requirement 2026-11-10): WAKE_LOCK removed — the app must not
         keep the device awake, and no code path ever held a wakelock.
         FLAG_KEEP_SCREEN_ON is likewise no longer used anywhere. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <!-- V2.5 拍照录题改为应用内相机（快门后直接进入裁剪），需要 CAMERA 运行时权限。 -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- V2.3 拍照录题：仅拍照时需要相机，声明为可选（无相机设备仍可装）。 -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />
    <!-- Signature|privileged permission; only AppOps MODE_ALLOWED matters at runtime.
         Needed for the parent console "exempt apps" foreground detection (2-c). -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- Enumerate ALL installed packages in the parent console app list
         (getInstalledApplications). Required for full visibility on API 30+;
         on the API 29 test device it is a harmless no-op. This app is
         sideloaded (not distributed via Play), so the sensitive permission
         is acceptable here. -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <!-- Package visibility (API 30+): resolve launcher apps. Kept for any
         launcher-based lookups; QUERY_ALL_PACKAGES above makes it redundant
         but harmless. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".AntiAddictionApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.AntiAddiction"
        android:networkSecurityConfig="@xml/network_security_config"
        tools:targetApi="34">

        <activity
            android:name=".ui.QuizActivity"
            android:exported="false"
            android:theme="@style/Theme.AntiAddiction.Quiz"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|smallestScreenSize|uiMode|fontScale|density"
            tools:ignore="ConfigChanges" />



        <!-- V2.2: 童趣 growth screen is now the LAUNCHER — the app opens
             directly into the child-friendly KEEP-style home. -->
        <activity
            android:name=".ui.GrowthActivity"
            android:exported="true"
            android:theme="@style/Theme.AntiAddiction.Growth">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- V2.1 主动答题: voluntary practice, decoupled from the forced-quiz
             pipeline (no service state, no media mute, no lock task). -->
        <activity
            android:name=".ui.PracticeActivity"
            android:exported="false"
            android:theme="@style/Theme.AntiAddiction.Growth" />

        <!-- V2.3 拍照录题：家长从控制台进入，拍照（系统相机）+ AI 识别后入库。
             不导出；拍照由系统相机应用完成，本应用无需 CAMERA 权限。 -->
        <activity
            android:name=".ui.PhotoQuizActivity"
            android:exported="false"
            android:theme="@style/Theme.AntiAddiction.Growth" />

        <!-- Parent console: no intent-filter and NOT exported. Every onResume
             re-runs the parent password gate (batch 2-c). -->
        <activity
            android:name=".ui.ConsoleActivity"
            android:exported="false"
            android:theme="@style/Theme.AntiAddiction.Growth" />

        <!-- Settings (parent): entered from the growth home header; all
             management features (quiz update, permissions, parent console,
             service, lock screen, version) live here. -->
        <activity
            android:name=".ui.SettingsActivity"
            android:exported="false"
            android:theme="@style/Theme.AntiAddiction.Growth" />

        <receiver
            android:name=".BootReceiver"
            android:exported="true"
            android:directBootAware="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- 2026-11-21: 覆盖安装后自动重启守护服务（MY_PACKAGE_REPLACED 是
             受保护广播，仅系统可发；exported=false 即可收到）。修复"装完
             新版服务被杀且不弹题"的问题。 -->
        <receiver
            android:name=".AppUpdateReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Device administration receiver for the "real lock screen" feature (B10).
             The BIND_DEVICE_ADMIN permission is granted by the system when the user
             activates this admin via ACTION_ADD_DEVICE_ADMIN; it must NOT be declared
             as a normal <uses-permission>. -->
        <receiver
            android:name=".AntiAddictionDeviceAdmin"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin_policies" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <!-- V2.2: notification-listener stub — its "notification access" grant
             unlocks MediaSessionManager.getActiveSessions so MediaPauseHelper
             can PAUSE background players during a quiz. Parent grants it once
             from the settings page. -->
        <service
            android:name=".MediaSessionPauseService"
            android:exported="true"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- V2.2: persisted keepalive job — reboot-surviving fallback that
             restarts the foreground service if an OEM autostart manager
             suppressed the BOOT_COMPLETED start. -->
        <service
            android:name=".KeepAliveJobService"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <service
            android:name=".ScreenMonitorService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Screen monitoring for parental control anti-addiction" />
        </service>

        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="com.antidip.AppInitializer"
                android:value="androidx.startup" />
        </provider>

    </application>
</manifest>
